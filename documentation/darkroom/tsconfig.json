{
	"extends": ["../../tsconfig.base.json", "astro/tsconfigs/strictest"],
	"compilerOptions": {
		"declarationDir": null,
		"emitDeclarationOnly": false,
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"paths": {
			"$components/*": ["./src/components/*"]
		}
	},
	"include": [".astro/types.d.ts", "astro.config.ts", "src/**/*"],
	"exclude": ["dist", "node_modules"]
}
