{
	"name": "{{scope}}/{{kebabCase name}}",
	"version": "0.0.0",
	"description": {{{json description}}},
	"keywords": [
		"tools",
		"cli",
		"typescript"
	],
	"bugs": {
		"email": "contact@howmanysmall.com",
		"url": "{{issuesUrl}}"
	},
	"repository": {
		"type": "git",
		"url": "{{repositoryUrl}}",
		"directory": "apps/{{kebabCase name}}"
	},
	"license": "MIT",
	"author": {
		"name": "HowManySmall",
		"email": "contact@howmanysmall.com",
		"url": "https://howmanysmall.com"
	},
	"maintainers": [
		{
			"name": "HowManySmall",
			"email": "contact@howmanysmall.com",
			"url": "https://howmanysmall.com"
		}
	],
	"sideEffects": false,
	"type": "module",
	"bin": {
		"{{kebabCase name}}": "./dist/{{kebabCase name}}.js",
		"{{kebabCase name}}-bun": "./dist/{{kebabCase name}}-bun.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"lint:oxlint": "pnpm --workspace-root run lint:package apps/{{kebabCase name}}",
		"lint:oxlint:agent": "pnpm --workspace-root run lint:package:agent apps/{{kebabCase name}}",
		"prepublishOnly": "turbo run build --filter={{scope}}/{{kebabCase name}}",
		"test": "vitest run",
		"test:agent": "node --run test -- --reporter agent",
		"type-check": "tsrs --build",
		"type-check:agent": "node --run type-check -- --pretty false"
	},
	"devDependencies": {
		"@cliffy/command": "catalog:runtime",
		"@howmanysmall/cli-utilities": "workspace:*",
		"@howmanysmall/project-configurations": "workspace:*",
		"@total-typescript/ts-reset": "catalog:types",
		"@types/node": "catalog:node-floor",
		"tsdown": "catalog:build",
		"unplugin-macros": "catalog:build",
		"vitest": "catalog:test"
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
