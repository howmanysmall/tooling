{
	"name": "{{scope}}/{{kebabCase name}}",
	"version": "0.0.0",
	"private": true,
	"description": {{{json description}}},
	"license": "MIT",
	"author": {
		"name": "HowManySmall",
		"email": "contact@howmanysmall.com",
		"url": "https://howmanysmall.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"lint:oxlint": "pnpm --workspace-root run lint:package packages/{{kebabCase name}}",
		"lint:oxlint:agent": "pnpm --workspace-root run lint:package:agent packages/{{kebabCase name}}",
		"test": "vitest run",
		"test:agent": "node --run test -- --reporter agent",
		"type-check": "tsc --build",
		"type-check:agent": "node --run type-check -- --pretty false"
	},
	"devDependencies": {
		"@howmanysmall/project-configurations": "workspace:*",
		"@types/node": "catalog:types",
		"vitest": "catalog:test"
	},
	"engines": {
		"node": ">=22.18.0"
	}
}
