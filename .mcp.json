{
	"mcpServers": {
		"astro-docs": {
			"type": "http",
			"url": "https://mcp.docs.astro.build/mcp"
		},
		"chrome-devtools": {
			"args": ["scripts/get-chrome-path.sh", "--serve"],
			"command": "bash"
		},
		"fallow": {
			"args": ["--run", "fallow-mcp"],
			"command": "node"
		},
		"hk": {
			"args": ["x", "--", "hk", "mcp", "--root", "."],
			"command": "mise"
		},
		"npm-registry": {
			"args": ["x", "--", "npm-registry-mcp"],
			"command": "mise"
		},
		"openrouter-mcp": {
			"type": "http",
			"url": "https://mcp.openrouter.ai/mcp"
		},
		"playwright": {
			"args": ["x", "--", "nlx", "@playwright/mcp@latest"],
			"command": "mise"
		}
	}
}
