{
	"name": "@howmanysmall/ai",
	"version": "0.0.0",
	"private": true,
	"description": "An internal package for AI.",
	"license": "MIT",
	"author": {
		"name": "HowManySmall",
		"email": "contact@howmanysmall.com",
		"url": "https://howmanysmall.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		"./ai-environment": "./src/ai-environment.ts",
		"./get-ai-environment-async": "./src/get-ai-environment-async.ts",
		"./get-openrouter-async": "./src/get-openrouter-async.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"lint:oxlint": "pnpm --workspace-root run lint:package packages/ai",
		"lint:oxlint:agent": "pnpm --workspace-root run lint:package:agent packages/ai",
		"test": "vitest run",
		"test:agent": "node --run test -- --reporter agent",
		"type-check": "tsrs --build",
		"type-check:agent": "node --run type-check -- --pretty false"
	},
	"dependencies": {
		"@arkenv/core": "catalog:runtime",
		"@openrouter/sdk": "catalog:ai"
	},
	"devDependencies": {
		"@howmanysmall/arktype-utilities": "workspace:*",
		"@howmanysmall/environment": "workspace:*",
		"@howmanysmall/project-configurations": "workspace:*",
		"@types/node": "catalog:node-floor",
		"type-fest": "catalog:types",
		"vitest": "catalog:test"
	},
	"engines": {
		"node": ">=22.18.0"
	}
}
