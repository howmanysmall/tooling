	"description": "Utilities relating to the English language.",
	"license": "MIT",
	"author": {
		"name": "HowManySmall",
		"email": "contact@howmanysmall.com",
		"url": "https://howmanysmall.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
