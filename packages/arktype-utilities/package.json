{
	"name": "@howmanysmall/arktype-utilities",
	"version": "0.0.0",
	"private": true,
	"description": "Shared arktype validators for primitives, JSON, and string dictionaries.",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"lint": "pnpm --workspace-root run lint:package packages/arktype-utilities",
		"lint:agent": "pnpm --workspace-root run lint:package:agent packages/arktype-utilities",
		"test": "vitest run",
		"test:agent": "node --run test -- --reporter agent",
		"type-check": "tsc --build",
		"type-check:agent": "node --run type-check -- --pretty false"
	},
	"dependencies": {
		"arktype": "catalog:runtime"
	},
	"devDependencies": {
		"@howmanysmall/project-configurations": "workspace:*",
		"vitest": "catalog:test"
	}
}
