{
	"name": "@howmanysmall/project-configurations",
	"version": "0.0.0",
	"private": true,
	"description": "Shared project configurations.",
	"license": "UNLICENSED",
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		"./tsdown": "./src/tsdown/shared.ts",
		"./tsdown/cli": "./src/tsdown/cli.ts",
		"./vitest": "./src/vitest/shared.ts",
		"./vitest/stryker": "./src/vitest/stryker.ts",
		"./vitest/vitiate": "./src/vitest/vitiate.ts"
	},
	"scripts": {
		"lint:oxlint": "pnpm --workspace-root run lint:package tools/project-configurations",
		"lint:oxlint:agent": "pnpm --workspace-root run lint:package:agent tools/project-configurations",
		"type-check": "tsc --build",
		"type-check:agent": "node --run type-check -- --pretty false"
	},
	"dependencies": {
		"@vitiate/core": "catalog:test",
		"arktype": "catalog:runtime",
		"jest-extended": "catalog:test",
		"tsdown": "catalog:build",
		"unplugin-macros": "catalog:build",
		"vitest": "catalog:test"
	},
	"devDependencies": {
		"@types/node": "catalog:types",
		"typescript": "catalog:tooling",
		"typescript7": "catalog:tooling"
	}
}
