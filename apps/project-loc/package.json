{
	"name": "@pobammer-ts/project-loc",
	"version": "0.1.0",
	"description": "Lines of code per project, counted with `scc`.",
	"keywords": [
		"tools",
		"cli",
		"typescript"
	],
	"bugs": {
		"email": "contact@howmanysmall.com",
		"url": "https://github.com/howmanysmall/tooling/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/howmanysmall/tooling.git",
		"directory": "apps/project-loc"
	},
	"license": "MIT",
	"author": {
		"name": "HowManySmall",
		"email": "contact@howmanysmall.com",
		"url": "https://howmanysmall.com"
	},
	"maintainers": [
		{
			"name": "HowManySmall",
			"email": "contact@howmanysmall.com",
			"url": "https://howmanysmall.com"
		}
	],
	"sideEffects": false,
	"type": "module",
	"bin": {
		"project-loc": "./dist/project-loc.js",
		"project-loc-bun": "./dist/project-loc-bun.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"lint:oxlint": "pnpm --workspace-root run lint:package apps/project-loc",
		"lint:oxlint:agent": "pnpm --workspace-root run lint:package:agent apps/project-loc",
		"prepublishOnly": "turbo run build --filter=@pobammer-ts/project-loc",
		"test": "vitest run",
		"test:agent": "node --run test -- --reporter agent",
		"type-check": "tsrs --build",
		"type-check:agent": "node --run type-check -- --pretty false"
	},
	"dependencies": {
		"ansis": "catalog:runtime",
		"arktype": "catalog:runtime",
		"fast-string-width": "catalog:runtime",
		"fdir": "catalog:runtime",
		"tinyexec": "catalog:runtime",
		"type-fest": "catalog:types",
		"which": "catalog:runtime"
	},
	"devDependencies": {
		"@cliffy/command": "catalog:runtime",
		"@howmanysmall/arktype-utilities": "workspace:*",
		"@howmanysmall/cli-utilities": "workspace:*",
		"@howmanysmall/project-configurations": "workspace:*",
		"@total-typescript/ts-reset": "catalog:types",
		"@types/node": "catalog:node-floor",
		"@types/which": "catalog:types",
		"tsdown": "catalog:build",
		"unplugin-macros": "catalog:build",
		"vitest": "catalog:test"
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
