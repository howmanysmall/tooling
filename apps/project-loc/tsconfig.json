{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/project-loc.tsbuildinfo",
		"paths": {
			"$constants/*": ["./src/constants/*"],
			"$functions/*": ["./src/functions/*"],
			"$meta/*": ["./src/meta/*"],
			"$package": ["./package.json"],
			"$types/*": ["./src/types/*"],
			"$utilities/*": ["./src/utilities/*"],
			"@cliffy/command/_dist/*": ["./node_modules/@cliffy/command/_dist/*"]
		},
		"types": ["node"]
	},
	"references": [
		{
			"path": "../../packages/arktype-utilities"
		},
		{
			"path": "../../packages/cli-utilities"
		},
		{
			"path": "../../tools/project-configurations"
		}
	],
	"include": ["src/**/*.ts", "./package.json", "*.config.ts"],
	"exclude": ["node_modules"]
}
