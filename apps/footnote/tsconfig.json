{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/footnote.tsbuildinfo",
		"paths": {
			"$constants": ["./src/constants.ts"],
			"$package": ["./package.json"],
			"@cliffy/command/_dist/*": ["./node_modules/@cliffy/command/_dist/*"]
		},
		"types": ["node"]
	},
	"references": [
		{
			"path": "../../packages/arktype-utilities"
		},
		{
			"path": "../../packages/cli-utilities"
		},
		{
			"path": "../../packages/file-utilities"
		},
		{
			"path": "../../tools/project-configurations"
		}
	],
	"include": ["src/**/*.ts", "./package.json", "*.config.ts"],
	"exclude": ["node_modules"]
}
