{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/darkroom.tsbuildinfo",
		"paths": {
			"$commands/*": [
				"./src/commands/*"
			],
			"$constants": [
				"./src/constants/constants.ts"
			],
			"$constants/*": [
				"./src/constants/*"
			],
			"$environment": [
				"./src/environment.ts"
			],
			"$functions/*": [
				"./src/functions/*"
			],
			"$types/*": [
				"./src/types/*"
			],
			"$utilities/*": [
				"./src/utilities/*"
			],
			"$validators/*": [
				"./src/validators/*"
			],
			"@cliffy/command/_dist/*": [
				"./node_modules/@cliffy/command/_dist/*"
			]
		},
		"types": [
			"node"
		]
	},
	"references": [
		{
			"path": "../../packages/arktype-utilities"
		},
		{
			"path": "../../packages/cli-utilities"
		},
		{
			"path": "../../packages/english-utilities"
		},
		{
			"path": "../../packages/string-utilities"
		},
		{
			"path": "../../tools/project-configurations"
		}
	],
	"include": [
		"src/**/*.ts",
		"./package.json",
		"*.config.ts"
	],
	"exclude": [
		"node_modules"
	]
}
