{
	"name": "@pobammer-ts/darkroom",
	"version": "0.0.1",
	"description": "A CLI for slopping together images with AI.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/howmanysmall/tooling.git",
		"directory": "apps/darkroom"
	},
	"license": "MIT",
	"author": {
		"name": "HowManySmall",
		"email": "contact@howmanysmall.com",
		"url": "https://howmanysmall.com"
	},
	"sideEffects": false,
	"type": "module",
	"bin": {
		"darkroom": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"lint:oxlint": "pnpm --workspace-root run lint:package apps/darkroom",
		"lint:oxlint:agent": "pnpm --workspace-root run lint:package:agent apps/darkroom",
		"prepublishOnly": "turbo run build --filter=@pobammer-ts/darkroom",
		"test": "bun x --bun vitest run",
		"test:agent": "node --run test -- --reporter agent",
		"type-check": "tsc --build",
		"type-check:agent": "node --run type-check -- --pretty false"
	},
	"dependencies": {
		"@arkenv/core": "catalog:runtime",
		"@cliffy/table": "catalog:runtime",
		"@dotenvx/dotenvx": "catalog:runtime",
		"@openrouter/sdk": "catalog:ai",
		"ansis": "catalog:runtime",
		"arktype": "catalog:runtime",
		"consola": "catalog:runtime",
		"effect": "catalog:runtime",
		"env-paths": "catalog:runtime",
		"type-fest": "catalog:types",
		"unplugin-macros": "catalog:build"
	},
	"devDependencies": {
		"@cliffy/command": "catalog:runtime",
		"@howmanysmall/arktype-utilities": "workspace:*",
		"@howmanysmall/cli-utilities": "workspace:*",
		"@howmanysmall/english-utilities": "workspace:*",
		"@howmanysmall/project-configurations": "workspace:*",
		"@howmanysmall/string-utilities": "workspace:*",
		"@total-typescript/shoehorn": "catalog:test",
		"@total-typescript/ts-reset": "catalog:types",
		"@types/node": "catalog:types",
		"tsdown": "catalog:build",
		"vitest": "catalog:test"
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
