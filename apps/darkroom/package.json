{
	"name": "@pobammer-ts/darkroom",
	"version": "0.0.0",
	"description": "A command-line tool.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/howmanysmall/tooling.git",
		"directory": "apps/darkroom"
	},
	"license": "MIT",
	"author": {
		"name": "HowManySmall",
		"email": "contact@howmanysmall.com",
		"url": "https://howmanysmall.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"darkroom": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"lint": "pnpm --workspace-root run lint:package apps/darkroom",
		"lint:agent": "pnpm --workspace-root run lint:package:agent apps/darkroom",
		"prepublishOnly": "turbo run build --filter=@pobammer-ts/darkroom",
		"test": "vitest run",
		"test:agent": "node --run test -- --reporter agent",
		"type-check": "tsc --build",
		"type-check:agent": "node --run type-check -- --pretty false"
	},
	"dependencies": {
		"@cliffy/command": "catalog:runtime"
	},
	"devDependencies": {
		"@howmanysmall/cli-utilities": "workspace:*",
		"@howmanysmall/project-configurations": "workspace:*",
		"@types/node": "catalog:types",
		"tsdown": "catalog:build",
		"unplugin-macros": "catalog:build",
		"vitest": "catalog:test"
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
